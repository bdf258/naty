# ===========================================
# Docker Compose Environment Configuration
# ===========================================

# Server Configuration
# --------------------
# Gemini API Key for LLM support (server-side, kept secure)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS configuration on the server)
# Set this to your frontend's public URL
FRONTEND_URL=http://localhost

# Server port (optional, defaults to 3001)
SERVER_PORT=3001

# Frontend Configuration
# ----------------------
# API URL for the backend server (what the browser uses to reach the API)
# In production, set this to your server's public URL (e.g., https://api.yourdomain.com)
VITE_API_URL=http://localhost:3001

# Frontend port (optional, defaults to 80)
FRONTEND_PORT=80
